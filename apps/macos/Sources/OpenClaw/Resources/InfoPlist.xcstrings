    "NSAppleEventsUsageDescription" : {
      "comment" : "Usage description for AppleEvents / Automation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : { "state" : "translated", "value" : "OpenClaw needs Automation (AppleScript) permission to drive Terminal and other apps for agent actions." }
        },
        "zh-Hans" : {
          "stringUnit" : { "state" : "translated", "value" : "OpenClaw 需要自动化（AppleScript）权限，以便助手驱动终端等其他应用。" }
        }
      }
    },
