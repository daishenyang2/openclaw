    "Allow signed tools (e.g. `peekaboo`) to drive UI automation via PeekabooBridge.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许已签名的工具（如 `peekaboo`）通过 PeekabooBridge 驱动 UI 自动化。"
          }
        }
      }
    },
    "Allow the agent to capture a photo or short video via the built-in camera.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许助手通过内置摄像头拍照或录制短视频。"
          }
        }
      }
    },
    "Allow the agent to show and control the Canvas panel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许助手显示并控制 Canvas 面板。"
          }
        }
      }
    },
    "Allow these so OpenClaw can notify and capture when needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许这些权限，使 OpenClaw 能在需要时通知并捕获信息。"
          }
        }
      }
    },
    "Allow this command?": {
